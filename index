<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>SENTRY · Monitoreo térmico</title>
<style>
:root{--bg:#0a1220;--p:#101c30;--b:#1f2f4a;--t:#e8eef9;--m:#8ea3c4;--g:#22d172;--a:#f5a524;--r:#e0243f}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--t);font:14px/1.4 "Segoe UI",system-ui,sans-serif;height:100vh;display:grid;grid-template:68px 1fr/210px 1fr}
header{grid-column:1/3;display:flex;align-items:center;gap:18px;padding:0 24px;background:#0c1626;border-bottom:1px solid var(--b)}
.logo{display:flex;align-items:center;gap:10px;font-size:26px;font-weight:800;letter-spacing:1px;min-width:186px}
header h1{font-size:19px}header small{display:block;color:var(--m);font-size:12px;font-weight:400}
.sp{flex:1}
.pill{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;background:#0f3a2b;color:var(--g)}
.pill.al{background:#4a1220;color:#ff6b81;animation:bl 1s infinite}
@keyframes bl{50%{opacity:.55}}
#clk{font-size:19px;font-weight:700}#dt{color:var(--m);font-size:12px}
nav{background:#0b1524;border-right:1px solid var(--b);padding:22px 12px;display:flex;flex-direction:column;gap:10px}
nav button{display:flex;align-items:center;gap:10px;background:none;border:1px solid transparent;color:var(--t);padding:14px;border-radius:10px;font:inherit;cursor:pointer;text-align:left}
nav button:hover{background:#13213a}
nav button.on{background:linear-gradient(135deg,#c8213a,#7d1426);border-color:#e0506a}
.bd{margin-left:auto;background:var(--r);color:#fff;border-radius:50%;min-width:20px;height:20px;font-size:11px;display:grid;place-items:center}
.ft{margin-top:auto;color:var(--m);font-size:11px}
main{overflow:auto;padding:24px}
h2{font-size:22px}.sub{color:var(--m);font-size:12px;margin:2px 0 18px}
.top{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}
.lg{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--m)}
.lg i{width:150px;height:9px;border-radius:5px;background:linear-gradient(90deg,#000014,#3c006e,#aa145a,#f05a14,#ffc828,#ffffe6)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.card{background:var(--p);border:1px solid var(--b);border-radius:16px;padding:16px;transition:.3s}
.card.w{border-color:var(--a)}.card.a{border-color:var(--r);box-shadow:0 0 22px #e0243f55}
.ch{display:flex;justify-content:space-between;gap:10px;margin-bottom:12px}
.id{color:var(--m);font-size:11px;font-weight:700;letter-spacing:1px}
.ch h3{font-size:15px}
.chip{align-self:flex-start;white-space:nowrap;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:700;background:#0f3a2b;color:var(--g)}
.chip.w{background:#4a3410;color:var(--a)}.chip.a{background:#4a1220;color:#ff6b81}
.vw{color:#fff;position:relative;border-radius:10px;overflow:hidden;background:#000;aspect-ratio:16/9}
canvas{width:100%;height:100%;display:block}
.vw::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,#0000 0 3px,#0000001f 3px 4px)}
.ov{position:absolute;inset:8px 10px auto;display:flex;justify-content:space-between;font-size:11px;font-weight:700;text-shadow:0 0 4px #000;z-index:2}
.rec{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--r);margin-right:6px;animation:bl 1s infinite}
.tag{position:absolute;transform:translate(-50%,-50%);width:26%;height:36%;border:1px dashed #fffa;z-index:2}
.tag span{position:absolute;bottom:calc(100% + 3px);left:50%;transform:translateX(-50%);white-space:nowrap;background:#000b;padding:1px 6px;border-radius:3px;font-size:11px}
.cf{display:flex;align-items:center;gap:22px;margin-top:12px;flex-wrap:wrap}
.zn small{display:block;color:var(--m);font-size:11px}.zn b{font-size:20px}
.ok{color:var(--g)}.wa{color:var(--a)}.al2{color:#ff6b81}
.cf button,.btn{margin-left:auto;background:none;border:1px solid var(--b);color:var(--m);padding:6px 12px;border-radius:8px;font:inherit;font-size:12px;cursor:pointer}
.cf button:hover,.btn:hover{color:var(--t);border-color:var(--m)}
.btn.pr{background:#c8213a;border-color:#c8213a;color:#fff;font-weight:700;margin:0}
.pn{background:var(--p);border:1px solid var(--b);border-radius:16px;padding:20px;max-width:760px}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:9px 6px;border-bottom:1px solid var(--b)}th{color:var(--m);font-size:12px}
label{display:block;color:var(--m);font-size:12px;margin:12px 0 4px}
input,textarea{width:100%;background:#14233b;border:1px solid var(--b);color:var(--t);padding:11px;border-radius:8px;font:inherit}
.v{display:none}.v.on{display:block}
/* Botón EMERGENCIA y ventana de envío */
.em{margin:0;background:#d4142f;border:2px solid #ff6b81;color:#fff;font:inherit;font-weight:800;letter-spacing:1px;padding:9px 20px;border-radius:10px;cursor:pointer}
.em:hover{background:#ef1d3a}.em.hot{animation:pu 1s infinite}
@keyframes pu{0%{box-shadow:0 0 0 0 #ff2d4aaa}100%{box-shadow:0 0 0 16px #ff2d4a00}}
.mo{position:fixed;inset:0;background:#000a;display:none;place-items:center;z-index:50;padding:16px}.mo.on{display:grid}
.md{background:var(--p);border:1px solid var(--b);border-radius:16px;padding:22px;max-width:580px;width:100%;max-height:92vh;overflow:auto}
.md h3{color:var(--r);font-size:20px}.md textarea{height:200px;resize:vertical;font-size:14px}
.wl{display:block;margin-top:8px;padding:12px;border-radius:10px;border:1px solid #1f8f4f;background:#12331f;color:#4be58b;text-decoration:none;font-weight:700}
.wl.done{background:#22d172;color:#06210f}
/* Escenarios de demostración */
.esc{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:0 0 16px;padding:12px;background:var(--p);border:1px solid var(--b);border-radius:12px}
.esc b{color:var(--m);font-size:12px;letter-spacing:1px;text-transform:uppercase}
.esc button{display:flex;flex-direction:column;align-items:flex-start;background:none;border:1px solid var(--b);color:var(--t);padding:8px 14px;border-radius:10px;font:inherit;font-weight:700;cursor:pointer}
.esc button small{font-weight:400;color:var(--m);font-size:11px}.esc button:hover{border-color:var(--m)}
.esc button.on{background:#c8213a;border-color:#c8213a;color:#fff}.esc button.on small{color:#ffd9de}.esc .rs{margin-left:auto}
.pres .esc b,.pres .esc button small{font-size:14px}.pres .esc button{font-size:16px}
/* Modo presentación: tema claro, más contraste y letra grande */
.pres{--bg:#eef2f8;--p:#fff;--b:#c5d0e2;--t:#0d1a2e;--m:#3d4f70;--g:#0a7d3f;--a:#a85a00;--r:#c4122f}
.pres header{background:#fff}.pres nav{background:#f8fafd}.pres nav button:hover{background:#e6edf8}.pres nav button.on{color:#fff}
.pres input,.pres textarea{background:#fff}.pres .wl{background:#e3f7ec;color:#0a7d3f;border-color:#0a7d3f}.pres .wl.done{background:#0a7d3f;color:#fff}.pres .pill{background:#d6f3e3}.pres .pill.al{background:#fbd3da;color:#c4122f}
.pres .chip{background:#d6f3e3}.pres .chip.w{background:#fde7c2}.pres .chip.a{background:#fbd3da;color:#c4122f}.pres .al2{color:#c4122f}
.pres header h1{font-size:23px}.pres header small,.pres .pill,.pres .chip,.pres .id,.pres .lg,.pres .ov,.pres .cf button,.pres #dt,.pres .zn small{font-size:14px}
.pres #clk{font-size:23px}.pres h2{font-size:28px}.pres .sub{font-size:15px}.pres nav button{font-size:17px}.pres .ch h3{font-size:19px}
.pres .zn b{font-size:27px}.pres .tag span{font-size:14px}.pres td,.pres th{font-size:15px}
@media(min-width:1500px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:900px){body{grid-template:auto auto 1fr/1fr;height:auto}header{grid-column:1}nav{flex-direction:row;overflow-x:auto;padding:10px}.ft{display:none}.grid{grid-template-columns:1fr}}
</style></head><body>
<header>
<div class="logo"><svg width="34" height="40" viewBox="0 0 34 40"><path d="M17 1 32 7v13c0 9-6 16-15 19C8 36 2 29 2 20V7z" fill="#1a0f1c" stroke="#e0243f" stroke-width="2.5"/><path d="M17 11c1 5 6 7 6 13a6 6 0 0 1-12 0c0-3 2-4 3-7 1 2 2 2 3-6z" fill="#ff8a2a"/></svg>SENTRY</div>
<div><h1>Sistema de Alerta contra Incendios</h1><small>Monitoreo térmico en tiempo real</small></div>
<div class="sp"></div><button class="btn" id="sn" style="margin:0">🔊 Sonido</button><button class="btn" id="pm" style="margin:0">Modo presentación</button><button class="em" id="em">🚨 EMERGENCIA</button><span class="pill" id="pill">● Sistema operativo</span>
<span id="dt"></span><span id="clk"></span>
</header>
<nav id="nav">
<button data-v="mon" class="on">▦ Monitoreo</button>
<button data-v="ph">▥ Histórico</button>
<button data-v="ale">♧ Alertas <span class="bd" id="bd">0</span></button>
<button data-v="ph">▤ Reportes</button>
<button data-v="cfg">⚙ Configuración</button>
<div class="ft">SENTRY · Prototipo v0.2<br>Simulación · sin conexión a cámaras reales</div>
</nav>
<main>
<section class="v on" id="v-mon">
<div class="top"><div><h2>Monitoreo en vivo</h2><div class="sub">6 cámaras termográficas · umbrales ilustrativos</div></div><div class="sp"></div>
<div class="lg">20 °C <i></i> 120 °C</div></div>
<div class="esc" id="esc"><b>Demostración</b>
<button data-e="1">Escenario 01<small>1 cámara · Advertencia</small></button>
<button data-e="2">Escenario 02<small>Santa y Largos · Incendio</small></button>
<button data-e="3">Escenario 03<small>Llegada Norte y Sur · Crítico</small></button>
<button data-e="0" class="rs">↺ Normalizar</button></div>
<div class="grid" id="grid"></div>
</section>
<section class="v" id="v-ale"><h2>Alertas</h2><div class="sub">Eventos detectados en la sesión</div>
<div class="pn"><button class="btn" id="ack" style="margin:0 0 10px">Reconocer todas</button><table><thead><tr><th>Hora</th><th>Cámara</th><th>Zona</th><th>Temp.</th><th>Nivel</th></tr></thead><tbody id="log"></tbody></table></div></section>
<section class="v" id="v-cfg"><h2>Configuración</h2><div class="sub">Parámetros ilustrativos · validar con Seguridad Industrial</div>
<div class="pn"><label>Advertencia (°C)</label><input type="number" id="tw" value="70"><label>Alerta (°C)</label><input type="number" id="ta" value="80">
<p style="margin-top:14px"><button class="btn pr" id="sv">Guardar</button> <span id="ok" class="ok"></span></p>
<p class="sub" style="margin-top:14px">La gestión de IP, credenciales y conexiones debe realizarse en un backend seguro.</p></div></section>
<section class="v" id="v-ph"><h2>Próximamente</h2><div class="sub">Esta sección se desarrollará en la siguiente versión.</div></section>
</main>
<div class="mo" id="mo"><div class="md"><h3>🚨 Enviar alerta de EMERGENCIA</h3>
<p class="sub" style="margin:4px 0 10px">Revisa el mensaje y abre WhatsApp para cada contacto. El mensaje solo se envía cuando confirmas en WhatsApp.</p>
<textarea id="msg"></textarea><div id="ct"></div>
<button class="btn" id="cl" style="margin:12px 0 0">Cancelar</button></div></div>
<script>
const $=id=>document.getElementById(id);
// Cada zona: x,y (0-1) posición en la imagen, r radio del punto caliente, base °C normal
const CAMS=[
{id:'C01',name:'Patio de Chatarra – Zato',zones:[{n:'Faja transportadora',x:.54,y:.32,r:.15,base:34}]},
{id:'C02',name:'Manhole principales de cables de MT – Subestación Principal',zones:[{n:'Llegada Norte',x:.25,y:.4,r:.14,base:42},{n:'Llegada Sur',x:.77,y:.6,r:.13,base:41}]},
{id:'C03',name:'Subestación principal en Largos',zones:[{n:'S.E. 9.1 · Fuerza compresores',x:.31,y:.62,r:.13,base:48},{n:'S.E. 9.3',x:.75,y:.55,r:.15,base:46}]},
{id:'C04',name:'Acería',zones:[{n:'S.E. 01',x:.27,y:.55,r:.15,base:50},{n:'S.E. 03',x:.73,y:.55,r:.15,base:52}]},
{id:'C05',name:'Estación Santa – S.E. 17A',zones:[{n:'S.E. 17A',x:.55,y:.45,r:.16,base:44}]},
{id:'C06',name:'Estación Santa – Bombas de agua',zones:[{n:'Fuerza a bombas de agua',x:.38,y:.52,r:.14,base:40}]}];
let TH={warn:70,alert:80},LOG=[],unack=0,view='mon',ESC=0,TOPL=0,sil=false,snd=true,AC=null;
const CL=['ok','wa','al2'],NM=['Normal','Advertencia','ALERTA'],CC=['','w','a'];
CAMS.forEach((c,i)=>{c.ph=i*1.7;c.zones.forEach(z=>{z.t=z.base;z.a=0;z.lv=0;z.fire=false})});
$('grid').innerHTML=CAMS.map((c,i)=>`<article class="card" id="k${i}"><div class="ch"><div><span class="id">${c.id}</span><h3>${c.name}</h3></div><span class="chip" id="s${i}">Normal</span></div>
<div class="vw"><canvas width="160" height="90"></canvas>${c.zones.map((z,j)=>`<div class="tag" style="left:${z.x*100}%;top:${z.y*100}%"><span id="t${i}_${j}"></span></div>`).join('')}
<div class="ov"><span><i class="rec"></i>EN VIVO</span><span id="mx${i}"></span></div></div>
<div class="cf">${c.zones.map((z,j)=>`<div class="zn"><small>${z.n}</small><b id="v${i}_${j}"></b></div>`).join('')}<button data-f="${i}">Simular incendio</button></div></article>`).join('');
// Paleta térmica (iron)
const S=[[0,0,0,20],[.2,60,0,110],[.4,170,20,90],[.6,240,90,20],[.8,255,200,40],[1,255,255,230]];
const LUT=Array.from({length:256},(_,i)=>{const v=i/255;let k=1;while(k<5&&S[k][0]<v)k++;const a=S[k-1],b=S[k],f=(v-a[0])/(b[0]-a[0]);return[1,2,3].map(n=>a[n]+(b[n]-a[n])*f)});
const W=160,H=90;
document.querySelectorAll('canvas').forEach((cv,i)=>{CAMS[i].ctx=cv.getContext('2d');CAMS[i].im=CAMS[i].ctx.createImageData(W,H)});
// Fotos reales convertidas a escala térmica: C01 completa, C02 (Norte | Sur), C03 mitad izquierda, C05 y C06 completas.
// C03 mitad izquierda: foto real de S.E. 9.1 (conductores de fuerza a compresores) convertida a escala térmica. Mitad derecha (S.E. 9.3): simulada hasta tener su foto.
function loadPhoto(i,uri,x0,pw,oy){const im=new Image();im.onload=()=>{const o=document.createElement('canvas');o.width=pw;o.height=90;const q=o.getContext('2d');const f=Math.max(pw/im.width,90/im.height);q.drawImage(im,0,oy,im.width*f,im.height*f);const d=q.getImageData(0,0,pw,90).data,c=CAMS[i];c.lum=c.lum||new Float32Array(14400);c.mk=c.mk||new Uint8Array(14400);for(let y=0;y<90;y++)for(let x=0;x<pw;x++){const k=y*pw+x,j=y*160+x0+x;c.lum[j]=(d[k*4]*.3+d[k*4+1]*.59+d[k*4+2]*.11)/255;c.mk[j]=1}};im.src=uri}
loadPhoto(2,'data:image/jpeg;base64,',0,80,-10);
loadPhoto(0,'data:image/jpeg;base64,',0,160,-40);
loadPhoto(1,'data:image/jpeg;base64,',0,80,-5);
loadPhoto(1,'data:image/jpeg;base64,',80,80,-5);
loadPhoto(5,'data:image/jpeg;base64,',0,160,-25);
loadPhoto(4,'data:image/jpeg;base64,',0,160,-63);
let last=0;
function draw(ts){requestAnimationFrame(draw);if(ts-last<90)return;last=ts;
CAMS.forEach(c=>{const d=c.im.data;
for(let y=0,p=0;y<H;y++){const ny=y/H;for(let x=0;x<W;x++,p+=4){const nx=x/W;
let v=.1+.05*Math.sin(nx*7+c.ph+ts/4000)*Math.cos(ny*5)+Math.random()*.03;
if(c.mk&&c.mk[y*160+x])v=.06+Math.pow(c.lum[y*160+x],.6)*.28+Math.random()*.02;
for(const z of c.zones){const dx=(nx-z.x)*1.78,dy=ny-z.y;v+=z.a*Math.exp(-(dx*dx+dy*dy)/(2*z.r*z.r))}
const k=LUT[Math.min(255,Math.max(0,v*255|0))];d[p]=k[0];d[p+1]=k[1];d[p+2]=k[2];d[p+3]=255}}
c.ctx.putImageData(c.im,0,0)})}
requestAnimationFrame(draw);
// Conexión real: reemplazar la simulación de tick() por lecturas de tu backend (WebSocket/REST) con la temperatura de cada zona.
function tick(){let top=0;
CAMS.forEach((c,i)=>{let cl=0,mx=0;
c.zones.forEach((z,j)=>{const tg=z.goal!=null?z.goal+(Math.random()-.5)*2:(z.fire?98:z.base+(Math.random()-.5)*3);z.t+=(tg-z.t)*(z.rate||.2);
z.a=Math.min(.9,Math.max(0,(z.t-20)/110));mx=Math.max(mx,z.t);
const lv=z.t>=TH.alert?2:z.t>=TH.warn?1:0;
if(lv>z.lv){LOG.unshift({ts:new Date(),cam:c.id,zn:z.n,t:z.t,lv});LOG.length=Math.min(LOG.length,100);unack++;sil=false}
z.lv=lv;cl=Math.max(cl,lv);
const e=$(`v${i}_${j}`);e.textContent=z.t.toFixed(1)+' °C';e.className=CL[lv];
$(`t${i}_${j}`).textContent=z.n+' · '+z.t.toFixed(1)+'°C'});
$('mx'+i).textContent='MÁX '+mx.toFixed(1)+' °C';
$('s'+i).textContent=NM[cl];$('s'+i).className='chip '+CC[cl];$('k'+i).className='card '+CC[cl];top=Math.max(top,cl)});
$('pill').textContent=top==2?'● ALERTA ACTIVA':top==1?'● Advertencia':'● Sistema operativo';
$('pill').className='pill'+(top==2?' al':'');TOPL=top;$('em').classList.toggle('hot',top>=1);$('em').style.animationDuration=ESC==3?'.4s':'1s';
$('bd').textContent=unack;$('bd').style.display=unack?'grid':'none';
if(view=='ale')renderLog()}
function renderLog(){$('log').innerHTML=LOG.map(l=>`<tr><td>${l.ts.toLocaleTimeString('es-PE')}</td><td>${l.cam}</td><td>${l.zn}</td><td>${l.t.toFixed(1)} °C</td><td class="${CL[l.lv]}">${NM[l.lv]}</td></tr>`).join('')||'<tr><td colspan="5" style="color:var(--m)">Sin alertas</td></tr>'}
setInterval(tick,1000);tick();
function clock(){const n=new Date();$('clk').textContent=n.toLocaleTimeString('es-PE',{hour12:false});$('dt').textContent=n.toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'})}
setInterval(clock,1000);clock();
$('grid').onclick=e=>{const i=e.target.dataset.f;if(i==null)return;const c=CAMS[i];
const f=c.zones.some(z=>z.fire);if(f)c.zones.forEach(z=>z.fire=false);else c.zones[Math.random()*c.zones.length|0].fire=true;
e.target.textContent=f?'Simular incendio':'Detener simulación'};
$('nav').onclick=e=>{const b=e.target.closest('button');if(!b)return;view=b.dataset.v;
document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('on',x==b));
document.querySelectorAll('.v').forEach(x=>x.classList.toggle('on',x.id=='v-'+view));
if(view=='ale')renderLog()};
$('ack').onclick=()=>{unack=0;sil=true;tick()};
// Escenarios: [índice de cámara, índice de zona, temperatura objetivo °C]; r = velocidad de subida
const ESCS={1:{z:[[0,0,76]],r:.12},2:{z:[[4,0,88],[2,0,84]],r:.18},3:{z:[[1,0,165],[1,1,152]],r:.4}};
function normalizar(){CAMS.forEach(c=>c.zones.forEach(z=>{z.goal=null;z.rate=0;z.fire=false;z.t=z.base;z.lv=0}));
document.querySelectorAll('[data-f]').forEach(b=>b.textContent='Simular incendio');LOG.length=0;unack=0;ESC=0}
function escenario(n){normalizar();if(n){ESC=n;ESCS[n].z.forEach(([i,j,g])=>{const z=CAMS[i].zones[j];z.goal=g;z.rate=ESCS[n].r})}
document.querySelectorAll('#esc button').forEach(b=>b.classList.toggle('on',ESC>0&&+b.dataset.e==ESC));tick()}
$('esc').onclick=e=>{const b=e.target.closest('button');if(b)escenario(+b.dataset.e)};
// Sonido de alarma (Web Audio, sin archivos). Suena mientras haya alerta sin reconocer; se silencia al pulsar EMERGENCIA o "Reconocer todas".
function ac(){if(!AC){try{AC=new(window.AudioContext||window.webkitAudioContext)()}catch(e){}}if(AC&&AC.state=='suspended')AC.resume();return AC}
function beep(f,d,v){const a=ac();if(!a)return;const o=a.createOscillator(),g=a.createGain(),t=a.currentTime;o.type='square';o.frequency.value=f;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+.02);g.gain.linearRampToValueAtTime(0,t+d);o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+d+.02)}
let sw=0;
setInterval(()=>{if(!snd||sil||TOPL<1)return;sw^=1;if(TOPL==1){if(sw)beep(700,.25,.12)}else if(ESC==3)beep(sw?1100:760,.45,.2);else beep(sw?880:660,.4,.16)},500);
document.addEventListener('click',()=>{if(snd)ac()});
$('sn').onclick=()=>{snd=!snd;$('sn').textContent=snd?'🔊 Sonido':'🔇 Silenciado';if(snd)beep(660,.15,.1)};
const CT=['+51 997 704 797','+51 924 137 024','+51 994 699 740'];
function mensaje(){const al=[];CAMS.forEach(c=>c.zones.forEach(z=>{if(z.lv>0)al.push({lv:z.lv,t:z.t,s:`📍 ${c.id} · ${c.name}${c.name.includes(z.n)?'':' → '+z.n}: ${z.t.toFixed(1)} °C (${NM[z.lv].toUpperCase()})`})}));
al.sort((a,b)=>b.lv-a.lv||b.t-a.t);
return `🚨 EMERGENCIA – SENTRY${ESC?' (SIMULACRO – DEMOSTRACIÓN)':''}\nAlerta térmica detectada por el sistema de monitoreo.\nFecha y hora: ${new Date().toLocaleString('es-PE')}\n`+(al.length?`Ubicación:\n${al.map(a=>a.s).join('\n')}\n`:'Activación manual (sin alertas térmicas detectadas en este momento).\n')+'Se solicita verificar el lugar de inmediato.'}
function links(){const t=encodeURIComponent($('msg').value);$('ct').innerHTML=CT.map(n=>`<a class="wl" target="_blank" rel="noopener" href="https://wa.me/${n.replace(/\D/g,'')}?text=${t}">📲 Enviar por WhatsApp a ${n}</a>`).join('')}
const cerrar=()=>$('mo').classList.remove('on');
$('em').onclick=()=>{sil=true;$('msg').value=mensaje();links();$('mo').classList.add('on')};
$('msg').oninput=links;$('cl').onclick=cerrar;
$('mo').onclick=e=>{if(e.target==$('mo'))cerrar()};
document.addEventListener('keydown',e=>{if(e.key=='Escape')cerrar()});
document.addEventListener('click',e=>{const a=e.target.closest('.wl');if(a)a.classList.add('done')});
$('pm').onclick=()=>{const on=document.body.classList.toggle('pres');$('pm').textContent=on?'Modo oscuro':'Modo presentación'};
$('sv').onclick=()=>{const w=+$('tw').value,a=+$('ta').value;
$('ok').textContent=w>0&&a>w?(TH={warn:w,alert:a},'Umbrales guardados'):'La alerta debe ser mayor que la advertencia'};
</script></body></html>
